<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <receiver
            android:name=".remote.RemoteServerDebugReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.sofatype.ime.debug.action.START_REMOTE_SERVER" />
                <action android:name="com.sofatype.ime.debug.action.STOP_REMOTE_SERVER" />
                <action android:name="com.sofatype.ime.debug.action.STATUS_REMOTE_SERVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.UpdateMockReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.sofatype.ime.debug.action.SET_UPDATE_ENDPOINT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".dicts.DictPackMockReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.sofatype.ime.debug.action.SET_DICT_CATALOG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
