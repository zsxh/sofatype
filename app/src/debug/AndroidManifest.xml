<?xml version="1.0" encoding="utf-8"?>
<!--
  T13 · debug 构建专有清单叠加（仅合入 debug 变体）：
  远程输入服务启停走查入口（PRD 决策 21 同口径——release 构建不合并本文件，
  该接收器在 release 中不存在，无暴露面）。
  T21 追加：检查更新 mock 走查入口 + usesCleartextTraffic（仅 debug 变体放开明文 HTTP，
  供模拟器访问本机 mock 更新源；release 保持系统默认阻止明文）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <receiver
            android:name=".remote.RemoteServerDebugReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.sofatype.ime.debug.action.START_REMOTE_SERVER" />
                <action android:name="com.sofatype.ime.debug.action.STOP_REMOTE_SERVER" />
                <action android:name="com.sofatype.ime.debug.action.STATUS_REMOTE_SERVER" />
            </intent-filter>
        </receiver>

        <!-- T21 · FR-D4 mock 走查通道：写内存级更新源接口地址覆写位（仅 debug 进程内生效） -->
        <receiver
            android:name=".update.UpdateMockReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.sofatype.ime.debug.action.SET_UPDATE_ENDPOINT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
