<?xml version="1.0" encoding="utf-8"?>
<!--
  T1 工程骨架：最小应用声明，产出可安装 APK。
  后续任务补入：T2 设置页 Activity、T3 输入法服务（IME service）。
  allowBackup=false：隐私红线姿态，应用数据不参与系统备份（AGENTS.md 禁止事项 2）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="sofatype"
        android:theme="@style/Theme.Sofatype">

        <!-- T2：设置页 Activity（FR-D1 最小集）。
             exported=true：TASKS T2 验收方式要求 adb `am start` 直达；
             系统输入法设置的入口由 @xml/method.xml 的 settingsActivity 声明（FR-D1），
             该 meta-data 在 T3 声明 IME service 时引用生效。 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label" />

    </application>

</manifest>
