<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SofatypeApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner_sofatype"
        android:icon="@mipmap/ic_launcher"
        android:label="sofatype"
        android:theme="@style/Theme.Sofatype">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TestTypingActivity"
            android:exported="true"
            android:label="@string/test_typing_label"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LogSettingsActivity"
            android:exported="true"
            android:label="@string/log_settings_label" />

        <activity
            android:name=".DictPackSettingsActivity"
            android:exported="true"
            android:label="@string/dict_settings_label" />

        <activity
            android:name=".LogViewerActivity"
            android:exported="true"
            android:label="@string/log_viewer_label" />

        <service
            android:name=".SofatypeImeService"
            android:exported="true"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
