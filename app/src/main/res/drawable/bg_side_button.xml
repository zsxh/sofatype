<?xml version="1.0" encoding="utf-8"?>
<!-- 引导副卡「远程输入」主按钮（T17 · FR-B1 / PRD 6.3 副卡主按钮）：accent-wash 底 + border-accent 描边；
     焦点/按压态主色描边口径与既有键盘一致（FR-A10/6.4「聚焦态 = 主色描边」）= 提亮至 accent-wash 上界 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash_strong" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash_strong" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
</selector>
