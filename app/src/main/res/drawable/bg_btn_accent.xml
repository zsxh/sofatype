<?xml version="1.0" encoding="utf-8"?>
<!-- 辅助按钮背景：accent-wash 底 + 主色描边（PRD 6.3）；焦点 = 淡底提亮至区间上界（PRD 6.4） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash_strong" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/btn_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/btn_corner" />
        </shape>
    </item>
</selector>
