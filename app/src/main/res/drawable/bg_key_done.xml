<?xml version="1.0" encoding="utf-8"?>
<!-- 完成键背景（FR-A10 / PRD 6.3，决策 44 修订）：常态收敛为键帽同款 key 底、无描边
     （非焦点不常亮）；焦点态（PRD 6.4「主色描边 + 微高亮底」）与按压态保留
     accent-wash 上界底 + border-accent 描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash_strong" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash_strong" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key" />
            <corners android:radius="@dimen/ime_key_corner" />
        </shape>
    </item>
</selector>
