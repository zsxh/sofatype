<?xml version="1.0" encoding="utf-8"?>
<!-- 候选 chip 高亮/焦点底（T10 · FR-A7 首候选高亮；PRD 6.3 高亮态 = accent-wash 底 + border-accent 描边；
     PRD 6.4 焦点态 = 主色描边 + 微高亮底，候选行焦点态复用同一底形）。普通 chip 无底色（画板① .bchip）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/accent_wash" />
    <stroke
        android:width="@dimen/stroke_width"
        android:color="@color/border_accent" />
    <corners android:radius="@dimen/ime_chip_corner" />
</shape>
