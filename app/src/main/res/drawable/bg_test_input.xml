<?xml version="1.0" encoding="utf-8"?>
<!-- 测试输入框背景（仅 debug）：默认 = card 底 + 编辑卡描边（PRD 6.3）；焦点 = 提亮 + 主色描边（PRD 6.4） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_hover" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent" />
            <corners android:radius="@dimen/test_input_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="@dimen/stroke_width" android:color="@color/border_accent_edit" />
            <corners android:radius="@dimen/test_input_corner" />
        </shape>
    </item>
</selector>
