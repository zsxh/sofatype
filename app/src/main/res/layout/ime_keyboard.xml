<?xml version="1.0" encoding="utf-8"?>
<!--
  T5 · 键盘悬浮层静态布局（画板①「字母键盘·小写」/ FR-A2 / 决策 7 R-1）。
  根容器 = 覆盖区 322dp：停靠屏幕底部，透明底透出宿主内容（悬浮卡片形态）。
  主卡 = 候选栏占位 + 键盘区（数字列/字母区/功能键区）+ 远程模式框架（T17 · FR-B3 / 决策 33：
  状态行 + 大字折行区 + 底部提示 + 「退出远程」，默认 GONE）；键帽由 KeyboardLayout
  模型驱动程序化生成（SofatypeImeService），跨两行完成键也在代码中挂载到键区。
  副卡 = 跨屏引导/配对/已连接三卡面容器（T17 · 决策 32，卡面内容由服务层装配，FR-B1/B4/B9）。
  主/副卡均含底部柔影垫层（PRD 6.3「黑 55% 模糊 30」的近似实现，见 bg_card_shadow）。
  全部色值/规格走 Token（colors.xml / dimens.xml），本文件不出现字面值。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ime_panel_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 卡片行：主卡 + 副卡，贴底排布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/ime_card_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ime_card_margin_h"
        android:paddingEnd="@dimen/ime_card_margin_h">

        <!-- 主卡（含柔影垫层）：包装层保持卡片几何，柔影外扩部分靠外层 clipChildren=false 放行；
             展开态高度由服务层切换 ime_card_height / ime_card_height_expanded（T11 · FR-A15） -->
        <FrameLayout
            android:id="@+id/main_card_wrap"
            android:layout_width="@dimen/ime_main_card_width"
            android:layout_height="@dimen/ime_card_height"
            android:clipChildren="false">

            <!-- 底部柔影（PRD 6.3 黑 55% 模糊 30 的垫层近似，画板① 柔影层）：垫在卡体之下 -->
            <View
                android:id="@+id/main_card_shadow"
                android:layout_width="@dimen/ime_card_shadow_width"
                android:layout_height="@dimen/ime_card_shadow_height"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_shadow" />

            <!-- 主卡：候选栏 + 展开行（T11，默认 GONE）+ 键盘区 -->
            <LinearLayout
                android:id="@+id/main_card"
                android:layout_width="@dimen/ime_main_card_width"
                android:layout_height="@dimen/ime_card_height"
                android:background="@drawable/bg_card"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/ime_card_padding_h"
                android:paddingTop="@dimen/ime_card_padding_v"
                android:paddingEnd="@dimen/ime_card_padding_h">

            <!-- 候选词栏（T10 · FR-A7）：仅候选词 chips（决策 1 不显示拼音串、决策 2 无语音入口），
                 无常亮高亮（决策 30，高亮仅随遥控器焦点态）；
                 chips 由服务层依组合态候选程序化生成；空态几何占位无条件保留——中/英模式 ×
                 字母/符号键盘全组合键区顶恒定（PRD 决策 42，FR-A7「英文模式候选栏隐藏、
                 键盘区上移」条款废止），键区上边距恒为本布局静态值；
                 远程模式候选栏显隐由服务层 renderRemoteUi 驱动（T17） -->
            <LinearLayout
                android:id="@+id/candidates_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ime_candidates_height"
                android:orientation="horizontal" />

            <!-- 更多候选展开行（T11 · FR-A15）：候选栏下方第二行候选，分页展示（页内容由服务层装载），
                 默认 GONE；可见时主卡切展开态高度，键区随之下移 -->
            <LinearLayout
                android:id="@+id/more_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ime_candidates_height"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- 远程模式主卡框架（T17 · FR-B3 / 决策 33，画板⑤）：状态行（点 + 状态文字 + 来自·设备名 +
                 「退出远程」按钮）+ 40px 大字自动折行区（T33 决策 31 口径不变）+ 底部提示。
                 进入远程模式时显示（候选栏/键区隐藏），退出（上屏成功自动收起 / 「退出远程」/ 服务停止）回键盘态；
                 状态行三态（未连接灰 / 等待扫码青 / 已连接绿，FR-B9）由服务层依状态机刷新。默认 GONE。 -->
            <LinearLayout
                android:id="@+id/remote_mode_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 状态行（FR-B3 / FR-B9）：点随状态切灰/青/绿，等待态无「来自·设备名」，右侧「退出远程」 -->
                <LinearLayout
                    android:id="@+id/remote_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/remote_status_dot"
                        android:layout_width="@dimen/ime_status_dot_size"
                        android:layout_height="@dimen/ime_status_dot_size"
                        android:background="@drawable/bg_status_dot_idle" />

                    <TextView
                        android:id="@+id/remote_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ime_remote_status_gap"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/ime_remote_status_text"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/remote_status_from"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ime_remote_status_gap"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/ime_remote_from_text"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/remote_exit_button"
                        android:layout_width="@dimen/ime_remote_exit_width"
                        android:layout_height="@dimen/ime_remote_exit_height"
                        android:background="@drawable/bg_key"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/ime_remote_exit_text" />
                </LinearLayout>

                <!-- 纵向滚动（决策 31「超出显示区高度纵向滚动保持末尾」）：TV 无触控故不显滚动条 -->
                <ScrollView
                    android:id="@+id/remote_text_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/ime_remote_area_margin_top"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <!-- 折行文本（宽度 = 卡内容区宽，无 maxLines 自动折行；末尾光标为文本尾 Span） -->
                    <TextView
                        android:id="@+id/remote_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/ime_remote_text_size"
                        android:letterSpacing="0.025" />
                </ScrollView>
            </LinearLayout>

            <!-- 远程模式主卡底部提示（T17 · FR-B3 原文，文案由服务层装载），随远程模式显隐 -->
            <TextView
                android:id="@+id/remote_bottom_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/ime_remote_hint_text"
                android:visibility="gone" />

            <!-- 键盘区：4 行键（模型驱动）+ 跨两行完成键（代码挂载） -->
            <FrameLayout
                android:id="@+id/key_area"
                android:layout_width="@dimen/ime_key_area_width"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ime_key_area_margin_top"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 键区 4 行容器一律关基线对齐（baselineAligned 默认 true 会把小字号功能键
                         文字键按基线对齐 30px 键文字下推 ~4px，行容器按自身边界裁剪溢出部分，
                         焦点态下边框被裁掉——T56 根因）；关掉后全部键帽按行顶对齐，行几何不变 -->
                    <LinearLayout
                        android:id="@+id/key_row_1"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ime_key_height"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/key_row_2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ime_key_height"
                        android:layout_marginTop="@dimen/ime_row_spacing"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/key_row_3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ime_key_height"
                        android:layout_marginTop="@dimen/ime_row_spacing"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/key_row_4"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ime_key_height"
                        android:layout_marginTop="@dimen/ime_row_spacing"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        </FrameLayout>

        <!-- 副卡（含柔影垫层）：跨屏三卡面容器（T17 · 决策 32）——引导卡（未连接，FR-B1）/
             配对卡（等待扫码，T14 · FR-B4）/ 已连接卡面（FR-B9 / 决策 32）；卡面内容由服务层装配；
             底对齐：主卡展开态加高时主/副卡保持底缘对齐（T11） -->
        <FrameLayout
            android:layout_width="@dimen/ime_side_card_width"
            android:layout_height="@dimen/ime_card_height"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/ime_card_gap"
            android:clipChildren="false">

            <View
                android:layout_width="@dimen/ime_side_card_shadow_width"
                android:layout_height="@dimen/ime_card_shadow_height"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_shadow" />

            <FrameLayout
                android:id="@+id/side_card"
                android:layout_width="@dimen/ime_side_card_width"
                android:layout_height="@dimen/ime_card_height"
                android:background="@drawable/bg_card" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
