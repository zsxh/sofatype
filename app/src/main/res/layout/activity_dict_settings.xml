<?xml version="1.0" encoding="utf-8"?>

<com.sofatype.ime.SettingsRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dict_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding_start"
        android:paddingTop="@dimen/page_padding_top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_app"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/breadcrumb_text_size" />

        <View
            android:layout_width="@dimen/breadcrumb_divider_w"
            android:layout_height="@dimen/breadcrumb_divider_h"
            android:layout_marginStart="@dimen/breadcrumb_gap"
            android:layout_marginEnd="@dimen/breadcrumb_gap"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_settings"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/breadcrumb_text_size" />

        <View
            android:layout_width="@dimen/breadcrumb_divider_w"
            android:layout_height="@dimen/breadcrumb_divider_h"
            android:layout_marginStart="@dimen/breadcrumb_gap"
            android:layout_marginEnd="@dimen/breadcrumb_gap"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_dict_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/breadcrumb_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ime_takeover_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/takeover_margin_top"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/version_card_padding_h"
        android:paddingTop="@dimen/takeover_padding_v"
        android:paddingEnd="@dimen/version_card_padding_h"
        android:paddingBottom="@dimen/takeover_padding_v"
        android:visibility="gone">

        <View
            android:id="@+id/takeover_dot"
            android:layout_width="@dimen/set_status_dot_size"
            android:layout_height="@dimen/set_status_dot_size"
            android:background="@drawable/bg_status_dot_error" />

        <TextView
            android:id="@+id/takeover_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/set_status_gap"
            android:text="@string/takeover_hint"
            android:textColor="@color/text_body"
            android:textSize="@dimen/takeover_text_size" />

        <Button
            android:id="@+id/btn_recover_ime"
            android:layout_width="@dimen/btn_width"
            android:layout_height="@dimen/btn_height"
            android:layout_marginStart="@dimen/btn_gap"
            android:background="@drawable/bg_btn_accent"
            android:contentDescription="@string/cd_btn_recover_ime"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/btn_recover_ime"
            android:textColor="@color/text_body"
            android:textSize="@dimen/btn_text"
            android:textStyle="normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dict_catalog_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/version_card_padding_h"
        android:paddingTop="@dimen/takeover_padding_v"
        android:paddingEnd="@dimen/version_card_padding_h"
        android:paddingBottom="@dimen/takeover_padding_v">

        <View
            android:id="@+id/dict_catalog_dot"
            android:layout_width="@dimen/set_status_dot_size"
            android:layout_height="@dimen/set_status_dot_size"
            android:background="@drawable/bg_status_dot_idle" />

        <TextView
            android:id="@+id/dict_catalog_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/set_status_gap"
            android:text="@string/dict_catalog_idle"
            android:textColor="@color/text_body"
            android:textSize="@dimen/takeover_text_size" />

        <Button
            android:id="@+id/btn_dict_refresh"
            android:layout_width="@dimen/btn_width"
            android:layout_height="@dimen/btn_height"
            android:layout_marginStart="@dimen/btn_gap"
            android:background="@drawable/bg_btn_accent"
            android:contentDescription="@string/btn_retry"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/btn_retry"
            android:textColor="@color/text_body"
            android:textSize="@dimen/btn_text"
            android:textStyle="normal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dict_settings_card"
        android:layout_width="@dimen/dict_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/dict_card_margin_top"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/version_card_padding_h"
        android:paddingTop="@dimen/version_card_padding_v"
        android:paddingEnd="@dimen/version_card_padding_h"
        android:paddingBottom="@dimen/version_card_padding_v">

        <LinearLayout
            android:id="@+id/dict_pack_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/dict_pack_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/version_card_padding_v"
            android:paddingBottom="@dimen/version_card_padding_v"
            android:text="@string/dict_catalog_empty"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/dict_row_meta_text"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/dict_settings_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/log_hint_margin_top"
        android:text="@string/dict_settings_hint"
        android:textColor="@color/text_hint_faint"
        android:textSize="@dimen/bottom_hint_text" />

</com.sofatype.ime.SettingsRootView>
