<?xml version="1.0" encoding="utf-8"?>
<!--
  T71 · 决策 60 画板 14 · 日志子页（面包屑 ｜ 日志）。
  日志设置卡（与设置页同款卡片）：行 1 开启调试日志（开关行）+ 行 2 日志大小限制（四档）+
  行 3 查看日志入口；行间分隔线。行容器聚焦态 = accent-wash 上界底 + border-accent 描边
  （bg_log_row，决策 50）；开关关闭时行 2/3 置灰不可调（置灰刷新在 LogSettingsActivity）。
  根视图 SettingsRootView：pre-IME 键分路（T54/T59/T67 口径）由 Activity 接线。
-->
<com.sofatype.ime.SettingsRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/log_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶部页签：sofatype 输入法 ｜ 设置 ｜ 日志（末段高亮，画板 14） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding_start"
        android:paddingTop="@dimen/page_padding_top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_app"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/breadcrumb_text_size" />

        <View
            android:layout_width="@dimen/breadcrumb_divider_w"
            android:layout_height="@dimen/breadcrumb_divider_h"
            android:layout_marginStart="@dimen/breadcrumb_gap"
            android:layout_marginEnd="@dimen/breadcrumb_gap"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_settings"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/breadcrumb_text_size" />

        <View
            android:layout_width="@dimen/breadcrumb_divider_w"
            android:layout_height="@dimen/breadcrumb_divider_h"
            android:layout_marginStart="@dimen/breadcrumb_gap"
            android:layout_marginEnd="@dimen/breadcrumb_gap"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/breadcrumb_log_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/breadcrumb_text_size" />
    </LinearLayout>

    <!-- T82 · 决策 66：默认输入法夺回检测横幅（与设置页同构，夺回态可见；默认态 GONE 零新增）。
         显隐刷新接线在 LogSettingsActivity（onResume / 窗口焦点回归，ImeTakeoverPrompt 共用件）；
         「一键选回」调 InputMethodManager.showInputMethodPicker()（公开 API 零权限）。 -->
    <LinearLayout
        android:id="@+id/ime_takeover_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/takeover_margin_top"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/version_card_padding_h"
        android:paddingTop="@dimen/takeover_padding_v"
        android:paddingEnd="@dimen/version_card_padding_h"
        android:paddingBottom="@dimen/takeover_padding_v"
        android:visibility="gone">

        <View
            android:id="@+id/takeover_dot"
            android:layout_width="@dimen/set_status_dot_size"
            android:layout_height="@dimen/set_status_dot_size"
            android:background="@drawable/bg_status_dot_error" />

        <TextView
            android:id="@+id/takeover_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/set_status_gap"
            android:text="@string/takeover_hint"
            android:textColor="@color/text_body"
            android:textSize="@dimen/takeover_text_size" />

        <Button
            android:id="@+id/btn_recover_ime"
            android:layout_width="@dimen/btn_width"
            android:layout_height="@dimen/btn_height"
            android:layout_marginStart="@dimen/btn_gap"
            android:background="@drawable/bg_btn_accent"
            android:contentDescription="@string/cd_btn_recover_ime"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/btn_recover_ime"
            android:textColor="@color/text_body"
            android:textSize="@dimen/btn_text"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- 日志设置卡（画板 14：620×326px、行高 100px） -->
    <LinearLayout
        android:id="@+id/log_settings_card"
        android:layout_width="@dimen/log_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/log_card_margin_top"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/version_card_padding_h"
        android:paddingTop="@dimen/version_card_padding_v"
        android:paddingEnd="@dimen/version_card_padding_h"
        android:paddingBottom="@dimen/version_card_padding_v">

        <!-- 行 1 · 开启调试日志（画板 14 焦点态行容器） -->
        <LinearLayout
            android:id="@+id/row_log_switch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/log_row_height"
            android:background="@drawable/bg_log_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/log_row_padding_h"
            android:paddingEnd="@dimen/log_row_padding_h">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_switch_label"
                android:textColor="@color/text_body"
                android:textSize="@dimen/log_row_label_text"
                android:textStyle="normal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.sofatype.ime.LogSwitchView
                android:id="@+id/log_switch"
                android:layout_width="@dimen/log_switch_width"
                android:layout_height="@dimen/log_switch_height"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/version_divider_h"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@color/divider_soft" />

        <!-- 行 2 · 日志大小限制（四档 1/2/5/10 MB；选中档 = 亮青加粗 + 3px 下划线，决策 47） -->
        <LinearLayout
            android:id="@+id/row_log_size"
            android:layout_width="match_parent"
            android:layout_height="@dimen/log_row_height"
            android:background="@drawable/bg_log_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/log_row_padding_h"
            android:paddingEnd="@dimen/log_row_padding_h">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_size_label"
                android:textColor="@color/text_body"
                android:textSize="@dimen/log_row_label_text"
                android:textStyle="normal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/log_size_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/log_size_gap">

                <LinearLayout
                    android:id="@+id/log_size_opt_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/log_size_text_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_size_1mb"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/log_size_text" />

                    <View
                        android:id="@+id/log_size_bar_1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_size_underline"
                        android:background="@color/accent_text"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/log_size_opt_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/log_size_gap"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/log_size_text_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_size_2mb"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/log_size_text" />

                    <View
                        android:id="@+id/log_size_bar_2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_size_underline"
                        android:background="@color/accent_text"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/log_size_opt_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/log_size_gap"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/log_size_text_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_size_5mb"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/log_size_text" />

                    <View
                        android:id="@+id/log_size_bar_5"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_size_underline"
                        android:background="@color/accent_text"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/log_size_opt_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/log_size_gap"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/log_size_text_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_size_10mb"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/log_size_text" />

                    <View
                        android:id="@+id/log_size_bar_10"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_size_underline"
                        android:background="@color/accent_text"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/version_divider_h"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@color/divider_soft" />

        <!-- 行 3 · 查看日志入口 + 右侧当前用量提示（画板 14） -->
        <LinearLayout
            android:id="@+id/row_log_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/log_row_height"
            android:background="@drawable/bg_log_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/log_row_padding_h"
            android:paddingEnd="@dimen/log_row_padding_h">

            <Button
                android:id="@+id/btn_view_logs"
                android:layout_width="@dimen/btn_width"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/bg_btn_accent"
                android:contentDescription="@string/cd_btn_view_logs"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/btn_view_logs"
                android:textColor="@color/text_body"
                android:textSize="@dimen/btn_text"
                android:textStyle="normal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/log_usage_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_usage_hint_off"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/log_usage_hint_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作提示（画板 14） -->
    <TextView
        android:id="@+id/log_settings_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/log_hint_margin_top"
        android:text="@string/log_settings_hint"
        android:textColor="@color/text_hint_faint"
        android:textSize="@dimen/bottom_hint_text" />

</com.sofatype.ime.SettingsRootView>
