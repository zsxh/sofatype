    <dimen name="btn_gap">7dp</dimen>
    <!-- 描边宽：PRD 6.1 卡片描边 1~1.5px，取 1.5px -->
    <dimen name="stroke_width">0.75dp</dimen>

    <!-- ═══ 键盘悬浮层（T5，画板①「字母键盘·小写」/ FR-A2 / 决策 7 R-1；1080p px ÷ 2 = dp/sp） ═══ -->
    <!-- 覆盖区：停靠屏幕底部、覆盖高 644px（决策 7 / R-1），透明底透出宿主内容 -->
    <dimen name="ime_panel_height">322dp</dimen>
    <!-- 悬浮卡片：主卡 1272×548、副卡 472×548，圆角 38（PRD 6.3），距底 48px、左右 72px、卡间 32px -->
    <dimen name="ime_card_height">274dp</dimen>
    <dimen name="ime_card_corner">19dp</dimen>
    <dimen name="ime_card_margin_h">36dp</dimen>
    <dimen name="ime_card_margin_bottom">24dp</dimen>
    <dimen name="ime_card_gap">16dp</dimen>
    <dimen name="ime_main_card_width">636dp</dimen>
    <dimen name="ime_side_card_width">236dp</dimen>
    <!-- 主卡展开态高度（T11 · FR-A15「更多⌄」展开第二行候选）：收起态卡内容 263dp（上下内边距 26 +
         候选栏 26 + 键区距 9 + 键区 202）留 11dp 余量；展开态 = 收起态 + 展开行 26dp，余量耗尽即 +15dp
         = 289dp（26 + 26 + 26 + 9 + 202），卡顶上移 15dp ≤ 覆盖区头部余量 24dp，键区整体下移 11dp、
         键位结构不变（列节奏断言不受影响，HANDOFF 模拟器坑 7 口径）。柔影随卡同步 +15dp -->
    <dimen name="ime_card_height_expanded">289dp</dimen>
    <dimen name="ime_card_shadow_height_expanded">301dp</dimen>
    <!-- 主卡内边距 26px/32px（画板① padding 26px 32px） -->
    <dimen name="ime_card_padding_v">13dp</dimen>
    <dimen name="ime_card_padding_h">16dp</dimen>
    <!-- 候选词栏：高 52px（PRD 6.3 候选 chip 行），chips 内容属 T10 -->
    <dimen name="ime_candidates_height">26dp</dimen>
    <!-- 候选 chip（T10 · PRD 6.3：高 52px=候选栏高、圆角 12、文字 28px、水平内边距 22px；
         chips 间距 16px（画板① 候选行 flex gap）） -->
    <dimen name="ime_chip_corner">6dp</dimen>
    <dimen name="ime_chip_text">14sp</dimen>
    <dimen name="ime_chip_padding_h">11dp</dimen>
    <dimen name="ime_chip_gap">8dp</dimen>
    <!-- 键盘区：宽 1200px、距候选栏 18px（画板① margin 18px auto 0） -->
    <dimen name="ime_key_area_width">600dp</dimen>
    <dimen name="ime_key_area_margin_top">9dp</dimen>
    <!-- 键帽：80×92、圆角 14、字符 30px；功能键文字 22px（PRD 6.3） -->
    <dimen name="ime_key_width">40dp</dimen>
    <dimen name="ime_key_height">46dp</dimen>
    <dimen name="ime_key_corner">7dp</dimen>
    <dimen name="ime_key_text">15sp</dimen>
    <dimen name="ime_key_fn_text">11sp</dimen>
    <!-- 键间 12px、行距 12px、列间隔本体 42px（画板① gap/spacer）。
         列间隔实宽 = 键距 12 + spacer 42 + 键距 12 = 66px：.krow 的 flex gap 对 spacer 两侧均生效，
         24px 键距由代码侧键 margin 与 spacer margin 合成，此处只存 spacer 本体宽 -->
    <dimen name="ime_key_spacing">6dp</dimen>
    <dimen name="ime_row_spacing">6dp</dimen>
    <dimen name="ime_column_spacer">21dp</dimen>
    <!-- 完成键：84×196 跨两行高键（FR-A10），字 26px，键区内偏移 1120px/208px（画板①） -->
    <dimen name="ime_done_key_width">42dp</dimen>
    <dimen name="ime_done_key_height">98dp</dimen>
    <dimen name="ime_done_key_text">13sp</dimen>
    <dimen name="ime_done_key_start">560dp</dimen>
    <dimen name="ime_done_key_top">104dp</dimen>
    <!-- 符号键盘空格键（T8，决策 3）：84×196 跨两行高键与完成键对称（画板③ col11 原点 1028px） -->
    <dimen name="ime_space_key_start">514dp</dimen>
    <!-- 键帽图标尺寸：上档 24px / 下屏 28px / 删除 32px / 光标 28px（画板① SVG 尺寸） -->
    <dimen name="ime_icon_shift">12dp</dimen>
    <dimen name="ime_icon_hide">14dp</dimen>
    <dimen name="ime_icon_backspace">16dp</dimen>
    <dimen name="ime_icon_cursor">14dp</dimen>
    <!-- 底部柔影垫层（PRD 6.3 黑 55% 模糊 30 / 画板① rgba(0,0,0,.55) blur(30px)、圆角 48）：
         尺寸 = 各自卡片 + 每侧 6dp 外扩（主卡 1272px / 副卡 472px，高 548px），近似 blur 扩散；
         主副卡宽度不同，垫层宽 Token 分列，禁止互相复用（评审第 2 轮 Major：副卡复用主卡宽致左溢 412dp） -->
    <dimen name="ime_card_shadow_width">648dp</dimen>
    <dimen name="ime_side_card_shadow_width">248dp</dimen>
    <dimen name="ime_card_shadow_height">286dp</dimen>
    <dimen name="ime_card_shadow_corner">24dp</dimen>

    <!-- ═══ 配对卡（T14 · FR-B4，画板⑤「远程模式」副卡；1080p px ÷ 2 = dp/sp） ═══
         二维码 376×376、圆角 38（圆角 Token 复用 ime_card_corner）；容器 padding 40px、
         二维码与地址行间距 10px（画板⑤ flex 容器 padding/gap）；地址一行字 22px（色 accent_text，
         PRD 6.1 URL 色，画板⑤ 原文）。二维码下方不显示其他文案（决策 4）。 -->
    <dimen name="ime_qr_size">188dp</dimen>
    <dimen name="ime_pairing_padding">20dp</dimen>
    <dimen name="ime_pairing_gap">5dp</dimen>
    <dimen name="ime_pairing_url_text">11sp</dimen>
    <!-- T35 · 决策 35：已连接态二维码与下方状态行间距（比地址行更松，户主 2026-11-07 反馈
         「已连接行太贴近二维码」后调整；1080p px ÷ 2 = dp） -->
    <dimen name="ime_pairing_status_gap">16dp</dimen>

    <!-- ═══ 远程模式主卡实时文本（T15 · FR-B3 显示部分，画板⑤；1080p px ÷ 2 = dp/sp） ═══
         大字 40px → 20sp（text_primary，letter-spacing 1px@40px ≈ 0.025em 走布局属性）；
         文本区顶距 88px（画板⑤ 状态行下方 margin-top）→ 44dp；光标 3×44px 圆角 2 → 1.5×22dp/1dp，
         与文字间隙 2px → 1dp。完整远程主卡（状态行 / 退出远程 / 底部提示）随 T17。 -->
    <dimen name="ime_remote_text_size">20sp</dimen>
    <dimen name="ime_remote_area_margin_top">44dp</dimen>
    <dimen name="ime_remote_cursor_width">1.5dp</dimen>
    <dimen name="ime_remote_cursor_height">22dp</dimen>
    <dimen name="ime_remote_cursor_gap">1dp</dimen>

    <!-- ═══ 跨屏引导副卡（T17 · FR-B1，画板①「字母键盘」右侧副卡；1080p px ÷ 2 = dp/sp） ═══
