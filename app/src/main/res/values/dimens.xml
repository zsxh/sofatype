    <dimen name="breadcrumb_gap">7dp</dimen>
    <dimen name="breadcrumb_divider_w">0.5dp</dimen>
    <dimen name="breadcrumb_divider_h">8dp</dimen>
    <!-- 测试输入区（仅 debug）：容器对齐设置卡宽 620px；输入框 96px 高、圆角 20px、字 30px -->
    <dimen name="test_area_width">310dp</dimen>
    <dimen name="test_input_height">48dp</dimen>
    <dimen name="test_input_corner">10dp</dimen>
    <dimen name="test_input_text">15sp</dimen>
    <dimen name="test_input_padding">12dp</dimen>
    <!-- 辅助按钮（对齐 PRD 6.3「检查更新按钮」196×64 / 圆角 14 / 字 19px；间距 14px） -->
