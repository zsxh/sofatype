    <dimen name="ime_remote_from_text">9sp</dimen>
    <dimen name="ime_remote_exit_width">60dp</dimen>
    <dimen name="ime_remote_exit_height">26dp</dimen>
    <dimen name="ime_remote_exit_text">11sp</dimen>
    <dimen name="ime_remote_hint_text">9sp</dimen>

