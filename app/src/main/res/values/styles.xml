<?xml version="1.0" encoding="utf-8"?>
<!-- 应用主题：全深色星夜青基底（PRD 第 6 章）。只用 framework Material 主题，不引第三方依赖。 -->
<resources>
    <style name="Theme.Sofatype" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <!-- 光标/选区控制色走主色 Token -->
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <!-- T71 · 决策 60：清空日志确认框走深色基底（framework Material 暗色 Alert）+ 主色控制色，
             与全深色星夜青一致（不引第三方依赖） -->
        <item name="android:alertDialogTheme">@style/Theme.Sofatype.Dialog</item>
    </style>

    <!-- T71：清空日志确认框主题（framework Material 暗色基底 + 主色控制色） -->
    <style name="Theme.Sofatype.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
    </style>
</resources>
